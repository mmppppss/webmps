# saldrán a http://localhost:3000/last en vez de /api/public/index.php/last
# y el servidor responderá 404.
#VITE_APP_API_URL=http://localhost:3000/api/public/index.php

# Producción:
VITE_APP_API_URL=https://mmppppss.rf.gd/api/public/index.php

