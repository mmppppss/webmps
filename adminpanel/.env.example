# URL de la API que usa el panel de administración.
#
# Este archivo tiene prioridad sobre el ../.env de la raíz del repositorio,
# para que en desarrollo NO se apunte a producción por accidente.
#
# Desarrollo (PHP local):
VITE_APP_API_URL=http://localhost:3000/api/public/index.php

# Producción (cámbialo al desplegar):
# VITE_APP_API_URL=https://infocamiri.rf.gd/api/public/index.php