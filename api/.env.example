# ── Base de datos ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_DATABASE=webmps
DB_USERNAME=root
DB_PASSWORD=tu_contraseña
DB_CHARSET=utf8mb4

# ── API ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos para CORS, separados por coma. NUNCA uses * con
# credenciales: el navegador lo rechaza.
# El panel y el sitio se sirven desde el mismo dominio, así que normalmente
# basta con el dominio de producción y localhost para desarrollo.
API_ALLOWED_ORIGINS=https://mmppppss.rf.gd,http://localhost:5173,http://localhost:5174

# ── Seguridad ───────────────────────────────────────────────────────────────
# Semilla para hashear las IP de los comentarios (anti-spam).
# Genera una con:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
COMMENT_HASH_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# ── Identidad del sitio ─────────────────────────────────────────────────────
#
# NO añadas SITE_NAME, SITE_TITLE, SITE_URL, SITE_TWITTER ni SITE_KEYWORDS.
# Esos valores viven en site.config.json (raíz del repositorio), que es la
# única fuente: lo leen api/index.php para las etiquetas SEO y api/sitemap.php.
#
# Aquí solo van las credenciales y los ajustes propios del servidor.