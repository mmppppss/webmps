# ── API ─────────────────────────────────────────────────────────────────────
# La URL debe incluir el prefijo /api/public/index.php, o las peticiones
# saldrán a http://localhost:3000/last en vez de /api/public/index.php/last
# y el servidor responderá 404.
VITE_APP_API_URL=http://localhost:3000/api/public/index.php

# Producción:
# VITE_APP_API_URL=https://mmppppss.rf.gd/api/public/index.php

# ── Identidad del sitio ─────────────────────────────────────────────────────
#
# NO añadas VITE_SITE_NAME, VITE_SITE_TITLE ni VITE_SITE_KEYWORDS aquí.
# La identidad del sitio vive en site.config.json (raíz del repositorio),
# que es la única fuente de verdad: lo leen esta web, el SEO que genera
# api/index.php y el sitemap.
#
# Así el nombre que ve el lector, el que aparece al compartir y el que
# Google indexa no pueden desincronizarse.
